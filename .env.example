# Copy to .env and set a key. Never commit .env.
#
# Generate a key (PowerShell or bash, needs Node 18+):
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Callers send it as the X-API-Key header on /api/v1/records.
DATABRIDGE_API_KEY=replace-with-a-generated-key

# Demo stack only: pull returns the stored synthetic values (default true). Set false for masked pulls.
# Allowed only in demo mode; the server refuses to start with it in integration mode.
DATABRIDGE_UNMASKED_PULL=true

# Not used by docker-compose.yml: the stack always runs in demo mode (synthetic records only),
# and no full-access key is configured.
